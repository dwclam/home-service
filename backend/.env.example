DB_URL=
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080

# Exact frontend origins, separated by commas; do not use * with cookies.
FRONTEND_ORIGINS=http://localhost:5173
# Use true when serving the API over HTTPS.
COOKIE_SECURE=false
SHOW_SQL=false
# Default schema mode; dev uses update and prod uses validate in their profile files.
DDL_AUTO=update
# Enable after adding the first reviewed migration in src/main/resources/db/migration.
FLYWAY_ENABLED=false

# SMTP: defaults work with a local Mailpit instance (SMTP 1025, inbox UI 8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@nestify.local

AUTH_OTP_TTL=10m
AUTH_OTP_RESEND_INTERVAL=60s
AUTH_OTP_MAX_ATTEMPTS=5
# Every validated login request counts, including successful logins.
AUTH_LOGIN_MAX_ATTEMPTS_PER_EMAIL_IP=5
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=30
AUTH_LOGIN_RATE_LIMIT_WINDOW=1m
# Generate TWO different secrets with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=nestify
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
